# ==============================================================================
# Racklyt Hub Configuration Environment Template
# ==============================================================================
# Copy this file to `.env` or set these environment variables in your deployment.
# NEVER commit your actual `.env` file to source control.

# Server Bind Settings
RACKLYT_HOST=0.0.0.0
RACKLYT_PORT=8443

# Path to persistent SQLite database
RACKLYT_DB_PATH=racklyt.db

# Path to static web build assets
RACKLYT_WEB_DIST=web/dist

# Logging level: trace, debug, info, warn, error
RUST_LOG=racklyt_hub=info,tower_http=info

# Optional: Master encryption secret for credentials at rest (AES-256-GCM)
# If left empty, a host-derived secret will be generated on first run.
# RACKLYT_SECRET_KEY=generate-a-secure-32-byte-hex-string-here

# Optional: Enforce HTTPS TLS certificate directly in Hub
# (Recommended: Use a reverse proxy like Cloudflare Tunnel, Caddy, or Nginx)
# RACKLYT_TLS_CERT=/path/to/fullchain.pem
# RACKLYT_TLS_KEY=/path/to/privkey.pem

# Optional: Proxmox Collector Default Polling Interval (in seconds)
# PROXMOX_POLL_INTERVAL_SECS=10

# Optional: SMTP Alert Dispatcher Defaults
# RACKLYT_SMTP_HOST=smtp.example.com
# RACKLYT_SMTP_PORT=587
# RACKLYT_SMTP_USER=alerts@example.com
# RACKLYT_SMTP_PASSWORD=your-secure-smtp-password
# RACKLYT_SMTP_FROM="Racklyt Monitoring <alerts@example.com>"

# ==============================================================================
# Racklyt Agent Configuration (Target Nodes)
# ==============================================================================
# These variables configure `racklyt-agent` running on monitored hosts:
# RACKLYT_HUB_URL=https://hub.internal.example.com:8443
# RACKLYT_AUTH_TOKEN=your-cryptographic-agent-token
# RACKLYT_NODE_ID=node-uuid-or-slug
# RACKLYT_INTERVAL_SECS=5
